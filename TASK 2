Replace `frontend/app/page.tsx` with:

```tsx
// frontend/app/page.tsx
"use client";
import { useState } from "react";

type Message = { role: "user" | "agent"; text: string };
type Memory  = { content: string; score?: number };

export default function Home() {
  const [messages, setMessages]   = useState<Message[]>([]);
  const [memories, setMemories]   = useState<Memory[]>([]);
  const [input, setInput]         = useState("");
  const [dealName, setDealName]   = useState("Acme Corp");
  const [loading, setLoading]     = useState(false);

  async function sendMessage() {
    if (!input.trim()) return;
    const userMsg = input;
    setInput("");
    setMessages(prev => [...prev, { role: "user", text: userMsg }]);
    setLoading(true);

    try {
      const res = await fetch("http://localhost:8000/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          user_id: "marcus",
          deal_name: dealName,
          message: userMsg
        })
      });
      const data = await res.json();
      setMessages(prev => [...prev, { role: "agent", text: data.response }]);
      setMemories(data.memories_used || []);
    } catch {
      setMessages(prev => [...prev, { role: "agent", text: "Connection error. Is the backend running?" }]);
    }
    setLoading(false);
  }

  return (
    <div style={{ display: "flex", height: "100vh", fontFamily: "sans-serif", background: "#0f0f0f", color: "#e5e5e5" }}>

      {/* ── CHAT PANEL ── */}
      <div style={{ flex: 1, display: "flex", flexDirection: "column", padding: "24px" }}>
        <h1 style={{ color: "#fff", marginBottom: 8 }}>⚡ PitchMind</h1>

        {/* Deal selector */}
        <div style={{ marginBottom: 16 }}>
          <label style={{ color: "#888", fontSize: 13 }}>Active deal: </label>
          <input value={dealName} onChange={e => setDealName(e.target.value)}
            style={{ background: "#1a1a1a", border: "1px solid #333", color: "#fff",
              borderRadius: 6, padding: "4px 10px", marginLeft: 8 }} />
        </div>

        {/* Messages */}
        <div style={{ flex: 1, overflowY: "auto", display: "flex", flexDirection: "column", gap: 12 }}>
          {messages.map((m, i) => (
            <div key={i} style={{
              alignSelf: m.role === "user" ? "flex-end" : "flex-start",
              background: m.role === "user" ? "#1d4ed8" : "#1a1a1a",
              border: "1px solid #2a2a2a",
              borderRadius: 10, padding: "10px 14px", maxWidth: "70%", lineHeight: 1.6
            }}>
              {m.text}
            </div>
          ))}
          {loading && <div style={{ color: "#666", fontStyle: "italic" }}>PitchMind is thinking...</div>}
        </div>

        {/* Input */}
        <div style={{ display: "flex", gap: 8, marginTop: 16 }}>
          <input
            value={input}
            onChange={e => setInput(e.target.value)}
            onKeyDown={e => e.key === "Enter" && sendMessage()}
            placeholder="Ask about your deal..."
            style={{ flex: 1, background: "#1a1a1a", border: "1px solid #333",
              color: "#fff", borderRadius: 8, padding: "10px 14px", fontSize: 15 }}
          />
          <button onClick={sendMessage} disabled={loading}
            style={{ background: "#1d4ed8", color: "#fff", border: "none",
              borderRadius: 8, padding: "10px 20px", cursor: "pointer", fontSize: 15 }}>
            Send
          </button>
        </div>
      </div>

      {/* ── MEMORY MONITOR PANEL ── */}
      <div style={{ width: 300, background: "#111", borderLeft: "1px solid #222",
        padding: 20, overflowY: "auto" }}>
        <h3 style={{ color: "#10b981", fontFamily: "monospace", marginBottom: 16, fontSize: 13 }}>
          ⚡ HINDSIGHT MEMORY
        </h3>
        {memories.length === 0 ? (
          <p style={{ color: "#444", fontSize: 13, fontStyle: "italic" }}>
            No past context retrieved yet.<br/><br/>
            Send a message to see Hindsight fetch memories in real time.
          </p>
        ) : (
          <>
            <p style={{ color: "#6b7280", fontSize: 12, marginBottom: 12 }}>
              {memories.length} memories retrieved
            </p>
            {memories.map((m, i) => (
              <div key={i} style={{ background: "#1a1a1a", border: "1px solid #10b98133",
                borderRadius: 8, padding: 10, marginBottom: 8 }}>
                <p style={{ color: "#d1fae5", fontSize: 12, lineHeight: 1.5 }}>
                  {m.content?.slice(0, 120)}...
                </p>
                {m.score && (
                  <p style={{ color: "#10b981", fontSize: 11, marginTop: 6 }}>
                    relevance: {(m.score * 100).toFixed(0)}%
                  </p>
                )}
              </div>
            ))}
          </>
        )}
      </div>

    </div>
  );
}
```

