### 🧠 Phase 2 — Connect Hindsight memory (Day 1–2, ~2 hours)

**Goal:** Every conversation is saved to Hindsight and retrieved on future messages.

Create `backend/memory.py`:

```python
# backend/memory.py
import httpx
import os

BASE = os.getenv("HINDSIGHT_BASE_URL")
KEY  = os.getenv("HINDSIGHT_API_KEY")
HEADERS = {"Authorization": f"Bearer {KEY}", "Content-Type": "application/json"}

async def fetch_memories(user_id: str, deal_name: str, query: str) -> list:
    """Ask Hindsight: what do we know about this deal?"""
    async with httpx.AsyncClient() as client:
        try:
            resp = await client.post(
                f"{BASE}/api/memory/search",
                headers=HEADERS,
                json={
                    "query": query,
                    "user_id": user_id,
                    "filters": {"deal": deal_name},
                    "top_k": 5
                },
                timeout=10.0
            )
            resp.raise_for_status()
            return resp.json().get("memories", [])
        except Exception as e:
            print(f"[Hindsight fetch error] {e}")
            return []  # agent still works, just without memory

async def save_memory(user_id: str, deal_name: str, content: str):
    """Save this interaction to Hindsight for future recall."""
    async with httpx.AsyncClient() as client:
        try:
            await client.post(
                f"{BASE}/api/memory/store",
                headers=HEADERS,
                json={
                    "user_id": user_id,
                    "content": content,
                    "metadata": {"deal": deal_name}
                },
                timeout=10.0
            )
        except Exception as e:
            print(f"[Hindsight save error] {e}")
```

Then update `backend/agent.py` to use memory:

```python
# backend/agent.py (updated)
from groq import Groq
from memory import fetch_memories, save_memory
import os

client = Groq(api_key=os.getenv("GROQ_API_KEY"))

SYSTEM_PROMPT = """You are PitchMind, an elite AI sales deal intelligence assistant.
You have access to the full memory of every past interaction about this deal.
USE IT. Reference past objections, promises, and context by name.
Never give generic advice when you have deal-specific memory available."""

async def run_agent(user_id: str, deal_name: str, user_message: str):
    # 1. Fetch relevant past memories
    memories = await fetch_memories(user_id, deal_name, user_message)

    # 2. Build memory context string to inject into the prompt
    memory_context = ""
    if memories:
        memory_context = "\n\n[DEAL MEMORY — USE THIS CONTEXT]\n"
        for m in memories:
            memory_context += f"- {m.get('content', '')}\n"

    # 3. Call Groq with memory injected
    try:
        response = client.chat.completions.create(
            model="qwen/qwen3-32b",
            messages=[
                {"role": "system", "content": SYSTEM_PROMPT + memory_context},
                {"role": "user", "content": f"Deal: {deal_name}\n\n{user_message}"}
            ],
            max_tokens=600
        )
        answer = response.choices[0].message.content
    except Exception as e:
        print(f"[LLM error] {e}")
        answer = "Sorry, I had trouble generating a response. Please try again."

    # 4. Save this exchange to Hindsight AFTER responding
    await save_memory(
        user_id, deal_name,
        content=f"User: {user_message} | Agent: {answer[:300]}"
    )

    return answer, memories  # return memories so frontend can display them
```

